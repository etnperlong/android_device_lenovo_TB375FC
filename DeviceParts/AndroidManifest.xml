<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.device"
    android:sharedUserId="android.uid.system"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- All signature(-level) permissions; uid 1000 passes the checks anyway, but declare
         them so the dependencies are explicit. -->
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.RESTRICT_DISPLAY_MODES" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.MONITOR_INPUT" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="lineageos.permission.HARDWARE_ABSTRACTION_ACCESS" />

    <application
        android:label="@string/app_name"
        android:persistent="true"
        android:allowBackup="false">

        <!-- Settings entry points. Settings shows an IA_SETTINGS activity of a system app on the
             page whose category key it declares, so the same screens are reachable from the
             homepage (all settings) and from the page each setting belongs to. -->
        <activity
            android:name=".DevicePartsActivity"
            android:exported="true"
            android:label="@string/device_parts_title"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.homepage" />
            <meta-data
                android:name="com.android.settings.group_key"
                android:value="top_level_system_info_category" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="top_level_device_parts" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="-25" />
            <meta-data
                android:name="com.android.settings.icon"
                android:resource="@drawable/ic_device_parts" />
            <meta-data
                android:name="com.android.settings.icon_tintable"
                android:value="true" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/device_parts_summary" />
        </activity>

        <activity
            android:name=".DisplayPartsActivity"
            android:exported="true"
            android:label="@string/display_parts_title"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="display_device_parts" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/display_parts_summary" />
        </activity>

        <activity
            android:name=".CoverPartsActivity"
            android:exported="true"
            android:label="@string/smart_cover_title"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.lockscreen" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="lockscreen_smart_cover" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/smart_cover_summary" />
        </activity>

        <activity
            android:name=".dolby.DolbyActivity"
            android:exported="true"
            android:label="@string/dolby_title"
            android:theme="@style/Theme.SubSettingsBase">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.sound" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="sound_dolby" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/dolby_summary" />
        </activity>

        <activity
            android:name=".dolby.DolbyEqualizerActivity"
            android:exported="false"
            android:label="@string/dolby_geq_title"
            android:theme="@style/Theme.SubSettingsBase" />

        <activity
            android:name=".dolby.DolbyAppsActivity"
            android:exported="false"
            android:label="@string/dolby_app_profiles_title"
            android:theme="@style/Theme.SubSettingsBase" />

        <service
            android:name=".touch.TapToWakeService"
            android:exported="false" />

        <service
            android:name=".display.DisplayPolicyService"
            android:exported="false" />

        <service
            android:name=".cover.CoverService"
            android:exported="false" />

        <service
            android:name=".audio.SpeakerRotationService"
            android:exported="false" />

        <service
            android:name=".dolby.DolbyService"
            android:exported="false" />

        <service
            android:name=".display.ReadingLowRefreshTile"
            android:exported="true"
            android:label="@string/tile_reading_low_refresh"
            android:icon="@drawable/ic_reading_low_refresh"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".touch.TouchGameModeTile"
            android:exported="true"
            android:label="@string/tile_touch_game_mode"
            android:icon="@drawable/ic_touch_game_mode"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <service
            android:name=".cover.SmartCoverTile"
            android:exported="true"
            android:label="@string/tile_smart_cover"
            android:icon="@drawable/ic_smart_cover"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
