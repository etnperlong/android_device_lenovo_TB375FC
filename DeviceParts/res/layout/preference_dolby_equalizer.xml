<!-- The response curve card of the equalizer page; resetting is the page's toolbar action. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <org.lineageos.settings.device.dolby.DolbyEqualizerView
        android:id="@+id/dolby_equalizer_chart"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/card_frame"
        android:contentDescription="@string/dolby_geq_description"
        android:paddingHorizontal="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp" />
</FrameLayout>
