<!-- Minimum dropdown, range slider, maximum dropdown, under a title set like other preference
     titles. The slider's label floats above it while dragging; a label within bounds would
     reserve room above the track and push it off the dropdowns' centre line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@android:id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textAppearance="?android:attr/textAppearanceListItem"
        android:textColor="?android:attr/textColorPrimary" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/cpu_range_minimum"
            android:layout_width="@dimen/cpu_range_spinner_width"
            android:layout_height="wrap_content" />

        <com.google.android.material.slider.RangeSlider
            android:id="@+id/cpu_range_slider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:theme="@style/Theme.Material3.DynamicColors.DayNight"
            app:labelBehavior="floating" />

        <Spinner
            android:id="@+id/cpu_range_maximum"
            android:layout_width="@dimen/cpu_range_spinner_width"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
