<!-- Stock ZUI layout-sw480dp/color_mode_preview_x: picture, heading, mode cards in a row. The
     picture is a swipeable 16:9 gallery of sample pictures here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <org.lineageos.settings.device.color.ScreenColorGallery
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_frame"
        android:clipToOutline="true">

        <include layout="@layout/screen_color_gallery_pages" />

        <ImageButton
            android:id="@+id/screen_color_gallery_fullscreen"
            style="@style/ScreenColorGalleryButton"
            android:layout_gravity="bottom|end"
            android:src="@drawable/ic_screen_color_fullscreen"
            android:contentDescription="@string/screen_color_gallery_fullscreen" />
    </org.lineageos.settings.device.color.ScreenColorGallery>

    <TextView
        android:id="@android:id/title"
        style="@style/CardHeading" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-4dp"
        android:layout_marginBottom="12dp"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="@color/card_secondary_text" />

    <RadioGroup
        android:id="@+id/option_cards"
        style="@style/OptionCards" />
</LinearLayout>
