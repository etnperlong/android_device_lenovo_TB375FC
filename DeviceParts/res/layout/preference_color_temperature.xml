<!-- Stock ZUI color_mode_preview_x, second half: heading, wheel card, preset cards in a row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd"
    android:paddingBottom="16dp">

    <TextView
        style="@style/CardHeading"
        android:text="@string/color_temperature_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/card_frame"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="24dp">

        <org.lineageos.settings.device.color.ColorWheelView
            android:id="@+id/color_wheel"
            android:layout_width="@dimen/screen_color_wheel_size"
            android:layout_height="@dimen/screen_color_wheel_size"
            android:contentDescription="@string/color_wheel_description" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_horizontal"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/card_secondary_text"
            android:text="@string/color_temperature_tip" />
    </LinearLayout>

    <RadioGroup
        android:id="@+id/color_temperature_group"
        style="@style/OptionCards"
        android:layout_marginTop="12dp">

        <RadioButton
            android:id="@+id/color_temperature_standard"
            style="@style/OptionCard"
            android:drawableTop="@drawable/ic_color_temperature_standard"
            android:text="@string/color_temperature_standard" />

        <RadioButton
            android:id="@+id/color_temperature_warm"
            style="@style/OptionCard"
            android:drawableTop="@drawable/ic_color_temperature_warm"
            android:text="@string/color_temperature_warm" />

        <RadioButton
            android:id="@+id/color_temperature_cool"
            style="@style/OptionCard"
            android:drawableTop="@drawable/ic_color_temperature_cool"
            android:text="@string/color_temperature_cool" />
    </RadioGroup>
</LinearLayout>
