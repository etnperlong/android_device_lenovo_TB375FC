<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/accessories_title">
    <PreferenceCategory
        android:key="category_pen"
        android:title="@string/category_pen_title">
        <SwitchPreferenceCompat
            android:key="pen_notifications"
            android:title="@string/pen_notifications_title"
            android:summary="@string/pen_notifications_summary"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="pen_refresh_cap"
            android:title="@string/pen_refresh_cap_title"
            android:summary="@string/pen_refresh_cap_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_keyboard"
        android:title="@string/category_keyboard_title">
        <SwitchPreferenceCompat
            android:key="keyboard_notifications"
            android:title="@string/keyboard_notifications_title"
            android:summary="@string/keyboard_notifications_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_cover"
        android:title="@string/category_cover_title">
        <SwitchPreferenceCompat
            android:key="smart_cover"
            android:title="@string/smart_cover_title"
            android:summary="@string/smart_cover_summary"
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
