<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/device_parts_title">
    <PreferenceCategory
        android:key="category_perf"
        android:title="@string/category_perf_title">
        <Preference
            android:key="perf"
            android:title="@string/perf_title"
            android:summary="@string/perf_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.perf.PerformanceActivity" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_display"
        android:title="@string/category_display_title">
        <SwitchPreferenceCompat
            android:key="pen_refresh_cap"
            android:title="@string/pen_refresh_cap_title"
            android:summary="@string/pen_refresh_cap_summary"
            android:persistent="false" />

        <SwitchPreferenceCompat
            android:key="reading_low_refresh"
            android:title="@string/reading_low_refresh_title"
            android:summary="@string/reading_low_refresh_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_touch"
        android:title="@string/category_touch_title">
        <SwitchPreferenceCompat
            android:key="touch_game_mode"
            android:title="@string/touch_game_mode_title"
            android:summary="@string/touch_game_mode_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_audio"
        android:title="@string/category_audio_title">
        <Preference
            android:key="dolby"
            android:title="@string/dolby_title"
            android:summary="@string/dolby_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.dolby.DolbyActivity" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_cover"
        android:title="@string/category_cover_title">
        <SwitchPreferenceCompat
            android:key="smart_cover"
            android:title="@string/smart_cover_title"
            android:summary="@string/smart_cover_summary"
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
