<!-- The homepage entry: the feature pages, grouped by the technology behind them. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/device_parts_title">
    <PreferenceCategory
        android:key="category_miravision"
        android:title="@string/category_miravision_title">
        <Preference
            android:key="screen_color"
            android:title="@string/screen_color_title"
            android:summary="@string/screen_color_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.color.ScreenColorActivity" />
        </Preference>

        <Preference
            android:key="video_picture"
            android:title="@string/video_picture_title"
            android:summary="@string/video_picture_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.color.VideoPictureActivity" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_dolby"
        android:title="@string/category_dolby_atmos_title">
        <Preference
            android:key="dolby"
            android:title="@string/dolby_title"
            android:summary="@string/dolby_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.dolby.DolbyActivity" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_perf"
        android:title="@string/category_perf_memory_title">
        <Preference
            android:key="perf"
            android:title="@string/perf_scheduling_title"
            android:summary="@string/perf_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.perf.PerformanceActivity" />
        </Preference>
        <Preference
            android:key="ram_expansion"
            android:title="@string/ram_expansion_title"
            android:summary="@string/ram_expansion_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.memory.RamExpansionActivity" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_accessories"
        android:title="@string/accessories_title">
        <Preference
            android:key="accessories"
            android:title="@string/accessories_title"
            android:summary="@string/accessories_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.AccessoriesActivity" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_misc"
        android:title="@string/category_misc_title">
        <Preference
            android:key="display_parts"
            android:title="@string/display_parts_title"
            android:summary="@string/display_parts_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.DisplayPartsActivity" />
        </Preference>
    </PreferenceCategory>
</PreferenceScreen>
