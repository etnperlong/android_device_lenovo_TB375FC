<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:title="@string/screen_color_title">
    <org.lineageos.settings.device.widget.OptionCardsPreference
        android:key="color_mode"
        android:title="@string/color_mode_title"
        app:layout="@layout/preference_color_mode" />

    <SwitchPreferenceCompat
        android:key="color_adaptive"
        android:title="@string/color_adaptive_title"
        android:summary="@string/color_adaptive_summary"
        android:persistent="false" />

    <PreferenceCategory
        android:key="category_color_advanced"
        android:title="@string/category_color_advanced_title"
        app:initialExpandedChildrenCount="0">
        <org.lineageos.settings.device.color.ColorTemperaturePreference
            android:key="color_temperature"
            android:title="@string/color_temperature_title" />

        <SeekBarPreference
            android:key="color_saturation"
            android:title="@string/color_saturation_title"
            android:persistent="false" />

        <SeekBarPreference
            android:key="color_contrast"
            android:title="@string/color_contrast_title"
            android:persistent="false" />

        <SeekBarPreference
            android:key="color_sharpness"
            android:title="@string/color_sharpness_title"
            android:persistent="false" />

        <Preference
            android:key="color_adjust_reset"
            android:title="@string/color_adjust_reset_title" />
    </PreferenceCategory>

    <Preference
        android:key="color_app_profiles"
        android:title="@string/color_app_profiles_title"
        android:summary="@string/color_app_profiles_summary">
        <intent
            android:targetPackage="org.lineageos.settings.device"
            android:targetClass="org.lineageos.settings.device.color.ScreenColorAppsActivity" />
    </Preference>

    <org.lineageos.settings.device.widget.DisclaimerFooterPreference
        android:key="miravision_footer"
        android:title="@string/disclaimer_miravision_trademark" />
</PreferenceScreen>
