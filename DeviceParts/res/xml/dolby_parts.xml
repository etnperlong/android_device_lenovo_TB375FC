<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/dolby_title">

    <org.lineageos.settings.device.widget.OptionCardsPreference
        android:key="dolby_mode"
        android:title="@string/dolby_mode_title"
        android:persistent="false" />

    <PreferenceCategory
        android:key="category_dolby_geq"
        android:title="@string/dolby_geq_title">
        <Preference
            android:key="dolby_geq"
            android:title="@string/dolby_geq_settings_title"
            android:summary="@string/dolby_geq_settings_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.dolby.DolbyEqualizerActivity" />
        </Preference>
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_dolby_music"
        android:title="@string/category_dolby_music_title">
        <ListPreference
            android:key="dolby_ieq_preset"
            android:title="@string/dolby_ieq_preset_title"
            android:dialogTitle="@string/dolby_ieq_preset_title"
            android:entries="@array/dolby_ieq_preset_entries"
            android:entryValues="@array/dolby_ieq_preset_values"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_dolby_movie"
        android:title="@string/category_dolby_movie_title">
        <SeekBarPreference
            android:key="dolby_dialogue_level"
            android:title="@string/dolby_dialogue_level_title"
            android:summary="@string/dolby_dialogue_level_summary"
            android:max="9"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_dolby_apps"
        android:title="@string/category_dolby_apps_title">
        <Preference
            android:key="dolby_app_profiles"
            android:title="@string/dolby_app_profiles_title"
            android:summary="@string/dolby_app_profiles_summary">
            <intent
                android:targetPackage="org.lineageos.settings.device"
                android:targetClass="org.lineageos.settings.device.dolby.DolbyAppsActivity" />
        </Preference>
    </PreferenceCategory>

    <com.android.settingslib.widget.FooterPreference
        android:key="dolby_footer" />
</PreferenceScreen>
