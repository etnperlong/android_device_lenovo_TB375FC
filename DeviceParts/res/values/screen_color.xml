<resources>
    <!-- Sample pictures at the top of the screen color page, in order, and who took each one
         (shown in full screen; also credit them in README.md). -->
    <array name="screen_color_gallery" translatable="false">
        <item>@drawable/screen_color_gallery_1</item>
        <item>@drawable/screen_color_gallery_2</item>
        <item>@drawable/screen_color_gallery_3</item>
        <item>@drawable/screen_color_gallery_4</item>
    </array>
    <string-array name="screen_color_gallery_credits" translatable="false">
        <item>Abdulaziz Hasan · Pexels</item>
        <item>Ruben Boekeloo · Pexels</item>
        <item>Alex M · Pexels</item>
        <item>Jerry Wang · Pexels</item>
    </string-array>

    <dimen name="screen_color_wheel_size">240dp</dimen>
    <dimen name="screen_color_gallery_dot_size">6dp</dimen>

    <style name="ScreenColorGalleryButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_margin">12dp</item>
        <item name="android:background">@drawable/screen_color_gallery_button_background</item>
        <item name="android:scaleType">center</item>
    </style>

    <style name="Theme.ScreenColorGallery"
        parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
