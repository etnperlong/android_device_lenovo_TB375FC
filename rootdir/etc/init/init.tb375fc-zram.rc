#
# RAM expansion: mmd (system/memory/mmd) sets up zram once after
# boot_completed, with a writeback file of mmd.zram.writeback.device_size
# bytes in /data/per_boot/zram (0 skips it), and recompresses idle slots with
# zstd (mmd.zram.recompression.algorithm in device.mk) while
# mmd.zram.recompression.enabled is true. DeviceParts stores the user's
# choices in persist.sys.tb375fc.zram.*; they are handed to mmd here, before
# mmd runs, so a change takes effect on the next boot. The sys.* copies tell
# DeviceParts what this boot applied. Installed to system_ext with
# DeviceParts, which owns these properties.

on property:ro.persistent_properties.ready=true
    setprop mmd.zram.comp_algorithm ${persist.sys.tb375fc.zram.comp_algorithm:-lz4}
    setprop mmd.zram.writeback.device_size ${persist.sys.tb375fc.zram.writeback_size:-0}
    setprop mmd.zram.recompression.enabled ${persist.sys.tb375fc.zram.recompression:-true}
    setprop sys.tb375fc.zram.comp_algorithm ${persist.sys.tb375fc.zram.comp_algorithm:-lz4}
    setprop sys.tb375fc.zram.writeback_size ${persist.sys.tb375fc.zram.writeback_size:-0}
    setprop sys.tb375fc.zram.recompression ${persist.sys.tb375fc.zram.recompression:-true}

# With zstd already the compression algorithm, recompressing with it only
# burns CPU: no slot gets smaller. Runs after the action above (same trigger,
# later in the file), whatever the recompression choice.
on property:ro.persistent_properties.ready=true && property:persist.sys.tb375fc.zram.comp_algorithm=zstd
    setprop mmd.zram.recompression.enabled false
