#
# vendor.lineage.health-service.tb375fc runs as system and drives charging through these
# nodes, which the kernel creates owned by root.

on boot
    chown system system /sys/class/wt-battery/charging_enabled
    chmod 0664 /sys/class/wt-battery/charging_enabled
    chown system system /sys/class/power_supply/battery/protection_setting_eu
    chmod 0664 /sys/class/power_supply/battery/protection_setting_eu
