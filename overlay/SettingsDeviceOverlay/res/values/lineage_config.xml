<resources>
    <!--
        Only the LineageOS peak refresh rate list is shown. Picking 144 is safe
        for the pen because DeviceParts caps the panel at 120 while the
        stylus is in use. The minimum-rate list and the AOSP smooth-display
        switch stay hidden: a forced minimum defeats idle power saving, and the
        list already covers what the switch does.
    -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>
    <bool name="config_show_min_refresh_rate_switch">false</bool>
    <bool name="config_show_smooth_display">false</bool>
</resources>
