<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.overlay.device.settings">
    <!-- Priority 0 sorts below stock's static vendor overlays (priority 1), so where both
         set a resource the stock value still wins, as it did with the old static overlays. -->
    <overlay
        android:targetPackage="com.android.settings"
        android:isStatic="true"
        android:priority="0" />
</manifest>
