<resources>
    <!--
        Wi-Fi only: no telephony country code, no ro.boot.wificountrycode and
        the driver reports no regulatory changes, so the framework has no
        country code at all, and soft AP refuses to start on 5 GHz or 6 GHz.
        Take the country code from the country IE of nearby access points
        instead, as the Pixel Wi-Fi overlays do.
    -->
    <bool name="config_wifiUpdateCountryCodeFromScanResultGeneric">true</bool>

    <!--
        Bridged soft AP: one hotspot on 2.4 GHz and 5 GHz at once (ap0 and
        ap1, ro.vendor.wifi.sap.interface / concurrent.iface). Stock's vendor
        WifiResOverlay sets it; MediaTek's Wi-Fi HAL offers a "Dual AP
        Concurrency" chip mode and the framework only bridges when the HAL's
        interface combinations allow it. STA + bridged AP stays off, as on
        stock: with Wi-Fi connected, the hotspot uses one band.
    -->
    <bool name="config_wifiBridgedSoftApSupported">true</bool>
</resources>
