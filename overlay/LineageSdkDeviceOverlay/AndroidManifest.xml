<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.overlay.device.lineagesdk">
    <!-- Static, so OverlayConfig builds its idmap in zygote: lineageos.platform resources are
         part of the system assets that PhoneWindowManager.init() reads. -->
    <overlay
        android:targetPackage="lineageos.platform"
        android:isStatic="true"
        android:priority="0" />
</manifest>
