<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.overlay.device.frameworkres">
    <!-- Priority 3 sorts above stock's MediaTek vendor overlays (FrameworkResOverlay 1,
         FrameworkResOverlayExt 2). They share only the brightness range, the light sensor type
         and config_showNavigationBar with this overlay, and on stock all of those come from
         Lenovo's /product overlays (not shipped here) rather than MediaTek's values. -->
    <overlay
        android:targetPackage="android"
        android:isStatic="true"
        android:priority="3" />
</manifest>
