<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.overlay.device.frameworkres">
    <!-- Priority 3 has no competitor left: stock's MediaTek framework overlays are not shipped
         (their remaining values live in this overlay), and on stock the brightness range, the
         light sensor type and config_showNavigationBar came from Lenovo's /product overlays
         (not shipped here) rather than MediaTek's values. -->
    <overlay
        android:targetPackage="android"
        android:isStatic="true"
        android:priority="3" />
</manifest>
