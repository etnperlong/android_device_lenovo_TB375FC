<resources>
    <!--
        Surfaces Settings -> Display -> Tap to wake. The toggle writes
        Settings.Secure.DOUBLE_TAP_TO_WAKE; DeviceParts observes that and
        mirrors it to /proc/gesture_control.
    -->
    <bool name="config_supportDoubleTapWake">true</bool>

    <!--
        Panel exposes 144Hz / 120Hz / 60Hz / 30Hz (confirmed via dumpsys
        display). The NVT active pen is reported to work only at <=120Hz;
        stock keeps 144 available and steers to 120 while the pen is in use
        (a 10 s pen timer inside MediaTek's SurfaceFlinger). Here that job is
        done by DeviceParts, which requests a 120Hz max refresh rate
        while stylus events arrive and drops it 10 s after the last one.
        config_defaultRefreshRate matches stock (144) so the default render
        vote does not hide 144; config_defaultPeakRefreshRate stays 120 so 144
        is only used after the user picks it in Settings. SurfaceFlinger
        still idles lower for power.
    -->
    <integer name="config_defaultPeakRefreshRate">120</integer>
    <integer name="config_defaultRefreshRate">144</integer>
    <integer name="config_defaultRefreshRateInZone">60</integer>

    <!--
        Display brightness, from the overlay stock actually runs:
        ZuiPeridotPrcFrameworksOverlay.apk (com.zui.android.overlay.common,
        /product/overlay, priority 3000). It sits above LgsiFrameworksOverlay
        (priority 2000), whose 23-point curve and 0.004173 minimum are never
        used on stock. A TB373FU running ZUI 17.5.10.095 reports the same
        values (cmd overlay lookup) and DisplayDeviceConfig maps slider
        brightness 0.0 to backlight 0.004713, never lower.

        The minimum matters: MediaTek's FrameworkResOverlay (vendor, priority
        1) sets config_screenBrightnessSettingMinimumFloat to 0.0, which lets
        the slider drive the backlight down to 0.0, below anything stock uses.
        This overlay's manifest priority keeps it above that overlay.

        Panel is a 400-nit LCD.
        - autoBrightnessLevels: ambient lux thresholds (11 values)
        - autoBrightnessDisplayValuesNits: target nits per lux band (12)
        - screenBrightnessBacklight: backlight 0-255 sample points (12)
        - screenBrightnessNits: nits at each backlight sample (12)
        - SettingMinimumFloat/MaximumFloat/DefaultFloat: backlight range of
          the slider, and its default
    -->
    <integer-array name="config_autoBrightnessLevels">
        <item>5</item> <item>15</item> <item>40</item> <item>100</item>
        <item>180</item> <item>400</item> <item>550</item> <item>1000</item>
        <item>1500</item> <item>2000</item> <item>2500</item>
    </integer-array>
    <integer-array name="config_autoBrightnessDisplayValuesNits">
        <item>8</item> <item>8</item> <item>30</item> <item>70</item>
        <item>100</item> <item>120</item> <item>150</item> <item>180</item>
        <item>210</item> <item>270</item> <item>340</item> <item>400</item>
    </integer-array>
    <integer-array name="config_screenBrightnessBacklight">
        <item>0</item> <item>5</item> <item>19</item> <item>45</item>
        <item>64</item> <item>77</item> <item>96</item> <item>115</item>
        <item>134</item> <item>172</item> <item>217</item> <item>255</item>
    </integer-array>
    <integer-array name="config_screenBrightnessNits">
        <item>0</item> <item>8</item> <item>30</item> <item>70</item>
        <item>100</item> <item>120</item> <item>150</item> <item>180</item>
        <item>210</item> <item>270</item> <item>340</item> <item>400</item>
    </integer-array>
    <integer name="config_autoBrightnessBrighteningLightDebounce">2000</integer>
    <integer name="config_autoBrightnessDarkeningLightDebounce">3000</integer>
    <item name="config_screenBrightnessSettingMinimumFloat" type="dimen" format="float">0.004713</item>
    <item name="config_screenBrightnessSettingMaximumFloat" type="dimen" format="float">1.0</item>
    <item name="config_screenBrightnessSettingDefaultFloat" type="dimen" format="float">0.470588</item>
    <integer name="config_screenBrightnessSettingMinimum">3</integer>

    <!--
        Display capability flags + legacy resources from LgsiFrameworksOverlay.
        AOD disabled (LCD-backlit panel, no per-pixel power control).
        dreamsEnabledByDefault=false so the screensaver doesn't auto-activate.
        keyguardUserSwitcher=true enables multi-user switch on lockscreen.
        showNavigationBar forced on so accidental hide doesn't lose nav.
        rounded_corner_radius=0 (panel has square corners).
    -->
    <bool name="config_automatic_brightness_available">true</bool>
    <bool name="config_dozeAlwaysOnDisplayAvailable">false</bool>
    <bool name="config_dreamsEnabledByDefault">false</bool>
    <bool name="config_keyguardUserSwitcher">true</bool>
    <bool name="config_showNavigationBar">true</bool>
    <dimen name="rounded_corner_radius">0dp</dimen>

    <!--
        Light sensor type. "defaultlightsensor" matches AOSP behaviour of
        picking the first TYPE_LIGHT sensor from the HAL. Explicit to mirror
        stock.
    -->
    <string name="config_displayLightSensorType" translatable="false">defaultlightsensor</string>

    <!--
        Desktop Windowing (A16 "Desktop Experience"): mark this 12.7" tablet as
        desktop-capable so the windowed-desktop mode and its developer toggle
        (Settings -> System -> Developer options -> Desktop mode) are available.
        This is the LineageOS/AOSP equivalent of stock's desktop mode. Pairs
        with persist.wm.freeform_window_management=1 (device.mk).
        - config_isDesktopModeSupported: device may host desktop sessions
        - config_canInternalDisplayHostDesktops: allow desktop on the built-in
          panel (not just an external display)
        - config_isDesktopModeDevOptionSupported: expose the dev-options toggle
    -->
    <bool name="config_isDesktopModeSupported">true</bool>
    <bool name="config_canInternalDisplayHostDesktops">true</bool>
    <bool name="config_isDesktopModeDevOptionSupported">true</bool>
</resources>
