<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.settings.smartcover"
    android:sharedUserId="android.uid.system"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false">

        <!-- KeyHandler is not an app component: PhoneWindowManager loads it into system_server
             from this APK (lineage-sdk config_deviceKeyHandlerLibs). -->

        <service
            android:name=".SmartCoverTile"
            android:exported="true"
            android:label="@string/tile_smart_cover"
            android:icon="@drawable/ic_smart_cover"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
